{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "version": "0.0.1",
  "name": "moca-ads-extension",
  "description": "Connect advertisers directly with publishers. No middlemen. Pure web3. Monetize your credentials.",
  "icons": {
    "48": "images/moca-ads-logo.png"
  },
  "background": {
    "chromium:service_worker": "background.ts",
    "firefox:scripts": [
      "background.ts"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "./content/scripts.tsx"
      ]
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://auth.privy.io/*",
    "https://*.air3.com/*",
    "https://*.mocachain.org/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://auth.privy.io https://*.air3.com https://*.mocachain.org;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "author": "Your Name"
}